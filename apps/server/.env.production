# Production Environment Configuration
NODE_ENV=production
PORT=443
DOMAIN_NAME="ccounter.duckdns.org"

# Security - CHANGE THIS SECRET IN PRODUCTION!
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_SECRET_KEY"

# SSL & HTTPS Configuration
ENFORCE_HTTPS=true
SSL_KEY_PATH="/etc/letsencrypt/live/ccounter.duckdns.org/privkey.pem"
SSL_CERT_PATH="/etc/letsencrypt/live/ccounter.duckdns.org/fullchain.pem"

# Database Connection
DATABASE_URL="file:./prod.db"

# CORS Configuration
CORS_ORIGIN="*"

# AI CLI Path & Prompts
AGY_PATH="/root/.local/bin/agy"
CLI_COMMAND_TEMPLATE="/root/.local/bin/agy --dangerously-skip-permissions --print '{{PROMPT}} Картинка находится по пути: {{IMAGE_PATH}}' --output-format json"
AI_SYSTEM_PROMPT="Проанализируй изображение. Если это готовое блюдо, определи его и рассчитай примерное количество калорий, белков, жиров и углеводов. Если это упаковка еды, прочитай пищевую ценность с этикетки. Также добавь любые релевантные аннотации (например, жирный соус или много витаминов). Верни только JSON с полями: calories (число), protein (число), carbs (число), fat (число), health_warnings (строка с важными коментариями на твое усмотрение)."
