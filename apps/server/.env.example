NODE_ENV=production
PORT=3000
JWT_SECRET="your-jwt-secret-here"
ENFORCE_HTTPS=false
# SSL_KEY_PATH="/path/to/privkey.pem"
# SSL_CERT_PATH="/path/to/fullchain.pem"
DATABASE_URL="file:./prod.db"
CORS_ORIGIN="*"
CLI_COMMAND_TEMPLATE="/root/.local/bin/agy --dangerously-skip-permissions --print '{{PROMPT}} Картинка находится по пути: {{IMAGE_PATH}}' --output-format json"
AI_SYSTEM_PROMPT="Проанализируй изображение..."
